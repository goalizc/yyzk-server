# 构建上下文 = 仓库根目录，只让镜像拿到需要的东西
.git
.gitignore
.venv
.tmp
.pipcache
.npmcache
node_modules
**/node_modules
**/__pycache__
**/*.py[cod]
.pytest_cache
.coverage
htmlcov

# 运行期数据与本地环境，绝不进镜像
deploy/data
deploy/.env
deploy/backups
deploy/certs
.env

# 文档与前端源码不参与后端镜像
docs
backend/tests
frontend/dist
.workbuddy
