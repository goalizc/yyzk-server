# 测试栈环境模板（复制为 .env.test 后修改；.env.test 已被 gitignore）
#   cp .env.test.example .env.test
# 与生产栈共享同一份 docker-compose.yml，但这些值必须独立。

# ---------- 部署标识 ----------
STACK_PREFIX=fault-test
HTTP_PORT=8080
# 默认只监听本机，避免测试账号暴露到局域网；需要局域网访问时改成 0.0.0.0
HTTP_BIND=127.0.0.1
DATA_DIR=./data-test

# ---------- 数据库 ----------
# 测试栈使用独立 DB 容器，库名和账号也必须与生产不同
DB_USER=fault_test
# 必须改掉：以 CHANGEME 开头的值会被 deploy-test.sh 直接拒绝启动
DB_PASSWORD=CHANGEME_至少16位强密码
DB_NAME=fault_test

# ---------- 数据库连接池 ----------
# 测试栈 db 只给 512m（docker-compose.test.yml）。默认 5+10 连接 × 2 worker
# 在低内存下有 OOM 风险，测试栈压到 3+5 足够（审查 M-07）。
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=10

# ---------- JWT ----------
# 必须与生产不同；生成：openssl rand -hex 32
JWT_SECRET=CHANGEME_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ---------- 时区 ----------
TZ=Asia/Shanghai

# ---------- 初始管理员 ----------
ADMIN_USERNAME=admin
ADMIN_INIT_PASSWORD=CHANGEME_至少8位测试口令
ADMIN_REAL_NAME=测试管理员

# ---------- 上传 ----------
MAX_UPLOAD_MB=20

# 测试栈开放接口文档，便于联调。
# 注意：DEBUG=true 且 HTTP_BIND=0.0.0.0 时 /api/docs 会暴露给整个网络，
# 需要局域网访问时请自行加防火墙或在前面套一层带鉴权的反代（审查 m-05）。
DEBUG=true
