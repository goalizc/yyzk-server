# 测试栈环境模板（复制为 .env.test 后修改；.env.test 已被 gitignore）
#   cp .env.test.example .env.test
# 与生产栈共享同一份 docker-compose.yml，但这些值必须独立。

# ---------- 部署标识 ----------
STACK_PREFIX=fault-test
HTTP_PORT=8080
# 默认只监听本机，避免测试账号暴露到局域网；需要局域网访问时改成 0.0.0.0
HTTP_BIND=127.0.0.1
DATA_DIR=./data-test

# ---------- 数据库 ----------
# 测试栈使用独立 DB 容器，库名和账号也必须与生产不同
DB_USER=fault_test
DB_PASSWORD=请改成至少16位强密码
DB_NAME=fault_test

# ---------- JWT ----------
# 必须与生产不同；生成：openssl rand -hex 32
JWT_SECRET=请改成独立的随机长字符串
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ---------- 时区 ----------
TZ=Asia/Shanghai

# ---------- 初始管理员 ----------
ADMIN_USERNAME=admin
ADMIN_INIT_PASSWORD=请设置至少8位测试口令
ADMIN_REAL_NAME=测试管理员

# ---------- 上传 ----------
MAX_UPLOAD_MB=20

# 测试栈开放接口文档，便于联调
DEBUG=true
