# ============================================================
# 环境变量配置 - 复制为 .env 后修改
#   cp .env.example .env
# ⚠ 本文件仅作模板，绝不能把真实密码提交到 Git
# ============================================================

# ---------- 数据库 ----------
DB_USER=fault
# 至少 16 位。生成方式用 hex，不要用 base64：
#   openssl rand -hex 24
# （base64 含 / + =，会被拼进 DATABASE_URL 后解析成错误的 host）
DB_PASSWORD=请改成一个强密码_至少16位
DB_NAME=fault_db

# ---------- JWT ----------
# 生成：openssl rand -hex 32
JWT_SECRET=请改成随机长字符串_建议用_openssl_rand_hex_32生成
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ---------- 时区 ----------
# 数据库与应用统一时区，影响所有时间字段与每日备份窗口
TZ=Asia/Shanghai

# ---------- 初始管理员（仅 init_admin.py 使用） ----------
ADMIN_USERNAME=admin
# 首次部署用，登录后请立即在「顶栏 → 修改密码」中更换
ADMIN_INIT_PASSWORD=请设置一个至少8位的初始密码
ADMIN_REAL_NAME=系统管理员

# ---------- 上传 ----------
MAX_UPLOAD_MB=20

# ---------- 调试 ----------
# true 时开放 /api/docs 与 /api/openapi.json（默认 false，对外不暴露接口清单）
DEBUG=false

# ---------- 构建源（可选，改了需重新 build） ----------
# 构建容器内没有宿主机的 ~/.pip/pip.conf 与 ~/.npmrc，源只能通过 build args 传入。
# pip 默认官方 PyPI（清华源对部分云主机 IP 会返回 403），npm 默认 npmmirror。
# PIP_INDEX_URL=https://pypi.org/simple
# PIP_TRUSTED_HOST=pypi.org
# NPM_REGISTRY=https://registry.npmmirror.com
# 基础镜像拉不动时，改成镜像站地址（或先 docker pull 再 tag 成同名）
# PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
# NODE_IMAGE=docker.m.daocloud.io/library/node:22-alpine
# NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.25-alpine
