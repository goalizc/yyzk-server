# 本地开发用环境变量模板：cp .env.example .env 后填值
# 目录部署时以 deploy/.env 为准（docker compose 读取），本文件只服务直接跑 uvicorn 的场景

# ---------- 数据库 ----------
DATABASE_URL=postgresql+psycopg2://fault:请改成强密码@localhost:5432/fault_db

# ---------- JWT ----------
# 生成：openssl rand -hex 32（少于 32 位启动会直接报错）
JWT_SECRET=请改成_openssl_rand_hex_32_生成的随机串
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ---------- 上传与时区 ----------
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=20
TZ=Asia/Shanghai

# ---------- 运行 ----------
LOG_LEVEL=INFO
DEBUG=false
