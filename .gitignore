# 忽略开发期产物
.venv/
node_modules/
.tmp/
.pipcache/
.npmcache/
.pgdata/
.pgrun/
.devdb/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# 构建产物
frontend/dist/
frontend/dist-verify/
dist/
# vite 加载 .js 配置时落盘的临时文件（异常退出会残留）
frontend/vite.config.js.timestamp-*.mjs

# 测试产物
frontend/test-results/
frontend/playwright-report/
frontend/.playwright/
frontend/.e2e-output/
# E2E 换输出目录时用的临时目录（绕开 .e2e-output 累积触发的批量删除拦截）
frontend/.e2e-run/
# 注：auto-imports.d.ts 不忽略——eslint.config.js 读它来识别自动注入的全局符号，
#     入库后新 clone 不必先跑一次 dev/build 才能 lint

# 运行期数据（部署目录内生成）
deploy/data/
deploy/backups/
deploy/certs/

# 环境变量（含真实密码，绝不入库）
.env
deploy/.env

# 工具与本地配置
.workbuddy/
.Trash-*/

# 编辑器与系统
.DS_Store
.idea/
.vscode/
*.swp
